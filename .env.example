# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SHEETS_WEBHOOK_URL: Google Apps Script web app URL that appends download rows
# to Google Sheets. Created by following APPS_SCRIPT_SETUP.md.
SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# SHEETS_SECRET: Shared secret the Apps Script verifies before appending a row.
# Must match the SHEETS_SECRET script property in the Apps Script project.
SHEETS_SECRET="CHANGE_ME"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN="CHANGE_ME"

# TELEGRAM_CHAT_ID: Your Telegram chat ID (see plan section 5.2 for how to get it).
TELEGRAM_CHAT_ID="CHANGE_ME"

# DEDUPE_WINDOW_MS: Ignore repeat download requests from the same IP within this
# window (analytics skipped; file is still served). Defaults to 10000.
# DEDUPE_WINDOW_MS=10000

# PLUGIN_ZIP_PATH: Optional override for the plugin zip path.
# Defaults to public/web2wa-plugin.zip.
# PLUGIN_ZIP_PATH="public/web2wa-plugin.zip"
